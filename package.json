{
  "name": "profilio",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types tests/technologies.test.mjs",
    "cv:build": "node --experimental-strip-types scripts/cv/build.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "npm run security:check",
    "security:check": "node scripts/security/check-build.mjs",
    "test:security": "node tests/security.test.mjs",
    "preview": "vite preview",
    "ghost:up": "docker compose up -d ghost mysql",
    "ghost:seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/ghost/seed.mjs",
    "ghost:pull": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/ghost/pull.mjs",
    "ghost:diff": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/ghost/diff.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
