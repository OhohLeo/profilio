# Serveur de production. Copier en .env.home (jamais committé), utilisé par : ./deploy.sh home ...
VITE_GHOST_URL=https://cms.example.com
VITE_GHOST_CONTENT_KEY=
GHOST_ADMIN_URL=https://cms.example.com
GHOST_ADMIN_API_KEY=
# Si le serveur utilise une autorité de certification privée (erreur SELF_SIGNED_CERT_IN_CHAIN) :
# NODE_EXTRA_CA_CERTS=/chemin/vers/ca.pem
# Si le serveur exige un certificat client (erreur « No required SSL certificate was sent ») :
# GHOST_ADMIN_CLIENT_CERT=/chemin/vers/client.pem
# GHOST_ADMIN_CLIENT_KEY=/chemin/vers/client.key
# GHOST_ADMIN_CLIENT_KEY_PASSPHRASE=   # si la clé client est chiffrée (« bad decrypt »)
