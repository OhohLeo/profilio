# Serveur de production. Copier en .env.home (jamais committé), utilisé par : ./deploy.sh home ...
VITE_GHOST_URL=https://cms.example.com
VITE_GHOST_CONTENT_KEY=
GHOST_ADMIN_URL=https://cms.example.com
GHOST_ADMIN_API_KEY=
# Optionnel : destination rsync du dossier dist/ (ex. user@serveur:/var/www/profilio/). Sinon dist/ est seulement construit.
DEPLOY_RSYNC_TARGET=
