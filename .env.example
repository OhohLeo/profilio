# --- Front (SPA) : lus par Vite au build, copier en .env.local ---
# URL publique de Ghost (sans slash final) et clé Content API (Réglages > Intégrations).
# La clé Content API est publique par conception. Sans ces deux valeurs, le site utilise src/data.ts.
VITE_GHOST_URL=http://localhost:2369
VITE_GHOST_CONTENT_KEY=

# --- Scripts (npm run ghost:*) : copier en .env, ne JAMAIS committer ---
GHOST_ADMIN_URL=http://localhost:2369
# Format "<id>:<secret hex>" : Réglages > Intégrations > Ajouter une intégration personnalisée.
GHOST_ADMIN_API_KEY=
