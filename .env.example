# Copier en .env (jamais committé). Lu par Vite (variables VITE_*), par les scripts npm et par deploy.sh.

# --- Front (SPA) : URL publique de Ghost (sans slash final) + clé Content API (Réglages > Intégrations).
# La clé Content API est publique par conception. Sans ces deux valeurs, le site utilise src/data.ts.
VITE_GHOST_URL=http://localhost:2369
VITE_GHOST_CONTENT_KEY=

# --- Scripts Ghost : API Admin. Format de la clé "<id>:<secret hex>" (Réglages > Intégrations > Intégration personnalisée).
GHOST_ADMIN_URL=http://localhost:2369
GHOST_ADMIN_API_KEY=

# --- Docker local (valeurs par défaut utilisables telles quelles)
# GHOST_PORT=2369
# WEB_PORT=8080
